{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": [
    "object",
    "null"
  ],
  "required": [
    "schema_version",
    "status",
    "binding",
    "source",
    "game",
    "visible_objects",
    "card_knowledge",
    "effect_claims",
    "legal_action_space",
    "unresolved",
    "execution",
    "read_only",
    "payment_source_tap_provenance"
  ],
  "additionalProperties": false,
  "$id": "urn:mtgaplayer:decision-state:v10",
  "title": "MTGAPlayer read-only DecisionState v10",
  "$comment": "Register State5/7/8/9/10 locally. V10 only adds separately bound explicit pre-request tap/untap event provenance. Old tapped literals and MP57 relation stay unchanged. Runtime additionally validates typed identities, cross-state order, source joins and current binding. No raw reauthentication, payability or input authority.",
  "properties": {
    "schema_version": {
      "const": "mtgaplayer.decision-state.v10"
    },
    "status": {
      "$ref": "urn:mtgaplayer:decision-state:v9#/properties/status"
    },
    "binding": {
      "$ref": "urn:mtgaplayer:decision-state:v9#/properties/binding"
    },
    "source": {
      "$ref": "urn:mtgaplayer:decision-state:v9#/properties/source"
    },
    "game": {
      "$ref": "urn:mtgaplayer:decision-state:v9#/properties/game"
    },
    "visible_objects": {
      "$ref": "urn:mtgaplayer:decision-state:v9#/properties/visible_objects"
    },
    "card_knowledge": {
      "$ref": "urn:mtgaplayer:decision-state:v9#/properties/card_knowledge"
    },
    "effect_claims": {
      "$ref": "urn:mtgaplayer:decision-state:v9#/properties/effect_claims"
    },
    "legal_action_space": {
      "$ref": "urn:mtgaplayer:decision-state:v9#/properties/legal_action_space"
    },
    "unresolved": {
      "$ref": "urn:mtgaplayer:decision-state:v9#/properties/unresolved"
    },
    "execution": {
      "$ref": "urn:mtgaplayer:decision-state:v9#/properties/execution"
    },
    "read_only": {
      "$ref": "urn:mtgaplayer:decision-state:v9#/properties/read_only"
    },
    "payment_source_tap_provenance": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/tapProvenance"
        }
      ]
    }
  },
  "allOf": [
    {
      "$ref": "urn:mtgaplayer:decision-state:v9#/allOf/0"
    },
    {
      "$ref": "urn:mtgaplayer:decision-state:v9#/allOf/1"
    },
    {
      "$ref": "urn:mtgaplayer:decision-state:v9#/allOf/2"
    },
    {
      "$ref": "urn:mtgaplayer:decision-state:v9#/allOf/3"
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "state_observed_without_request"
          }
        }
      },
      "then": {
        "properties": {
          "payment_source_tap_provenance": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "payment_source_tap_provenance": {
            "type": "object"
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "const": "state_and_request_observed"
          },
          "legal_action_space": {
            "properties": {
              "request_type": {
                "const": "GREMessageType_ActionsAvailableReq"
              },
              "request_parameters": {
                "type": "object",
                "properties": {
                  "profile": {
                    "const": "current_target_generic_two_predictive_association"
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record",
        "message",
        "state_id"
      ],
      "properties": {
        "record": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "message": {
          "type": "integer",
          "minimum": 0,
          "maximum": 511
        },
        "state_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "eventLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record",
        "message",
        "state_id",
        "annotation"
      ],
      "properties": {
        "record": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "message": {
          "type": "integer",
          "minimum": 0,
          "maximum": 511
        },
        "state_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "annotation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 511
        }
      }
    },
    "sourceWitness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mana_action_position",
        "identifier_refs",
        "witness_grade",
        "reason",
        "tap_pair",
        "untap"
      ],
      "properties": {
        "mana_action_position": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "identifier_refs": {
          "$ref": "urn:mtgaplayer:decision-state:v9#/$defs/manaLiteral/properties/identifier_refs"
        },
        "witness_grade": {
          "enum": [
            "explicit_pre_request_untap_then_continuous",
            "current_explicit_tapped",
            "conflict",
            "unknown"
          ]
        },
        "reason": {
          "enum": [
            "ambiguous_or_conflicting_tap_event",
            "current_explicit_tapped",
            "explicit_event_pair_then_continuous",
            "no_explicit_event_pair",
            "other_source_annotation",
            "prior_explicit_tap_pair_not_observed",
            "source_identity_changed",
            "source_not_current_own_public_battlefield",
            "source_row_replaced"
          ]
        },
        "tap_pair": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/eventLocation"
            }
          ]
        },
        "untap": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/eventLocation"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "witness_grade": {
                "const": "explicit_pre_request_untap_then_continuous"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "enum": [
                  "explicit_event_pair_then_continuous"
                ]
              },
              "tap_pair": {
                "$ref": "#/$defs/eventLocation"
              },
              "untap": {
                "$ref": "#/$defs/eventLocation"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "witness_grade": {
                "const": "current_explicit_tapped"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "enum": [
                  "current_explicit_tapped"
                ]
              },
              "tap_pair": {
                "type": "null"
              },
              "untap": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "witness_grade": {
                "const": "conflict"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "enum": [
                  "ambiguous_or_conflicting_tap_event"
                ]
              },
              "tap_pair": {
                "type": "null"
              },
              "untap": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "witness_grade": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "enum": [
                  "no_explicit_event_pair",
                  "other_source_annotation",
                  "prior_explicit_tap_pair_not_observed",
                  "source_identity_changed",
                  "source_not_current_own_public_battlefield",
                  "source_row_replaced"
                ]
              },
              "tap_pair": {
                "type": "null"
              },
              "untap": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "tapProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "binding",
        "action_position",
        "request_location",
        "checked_through",
        "sources",
        "historical_response_used"
      ],
      "properties": {
        "schema_version": {
          "const": "mtgaplayer.payment-source-tap-provenance.v1"
        },
        "binding": {
          "allOf": [
            {
              "$ref": "urn:mtgaplayer:decision-state:v9#/properties/binding"
            },
            {
              "properties": {
                "request_type": {
                  "const": "GREMessageType_ActionsAvailableReq"
                },
                "request_id": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              }
            }
          ]
        },
        "action_position": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "request_location": {
          "$ref": "#/$defs/location"
        },
        "checked_through": {
          "$ref": "#/$defs/location"
        },
        "sources": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sourceWitness"
          }
        },
        "historical_response_used": {
          "const": false
        }
      }
    }
  }
}
