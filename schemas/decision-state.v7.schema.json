{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mtgaplayer:decision-state:v7",
  "title": "MTGAPlayer read-only DecisionState v7",
  "$comment": "Register v5/v6/v7 locally by URN. V7 adds only current public Activate target-member consistency. Runtime binds all original positions/identities/shapes to the existing frontier/graph, checks public BF and observed ability status, and never infers target quantity, complete domain, payment, response or execution. Older contracts exclude this profile.",
  "type": [
    "object",
    "null"
  ],
  "required": [
    "schema_version",
    "status",
    "binding",
    "source",
    "game",
    "visible_objects",
    "card_knowledge",
    "effect_claims",
    "legal_action_space",
    "unresolved",
    "execution",
    "read_only"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "mtgaplayer.decision-state.v7"
    },
    "status": {
      "$ref": "urn:mtgaplayer:decision-state:v5#/properties/status"
    },
    "binding": {
      "$ref": "urn:mtgaplayer:decision-state:v5#/properties/binding"
    },
    "source": {
      "$ref": "urn:mtgaplayer:decision-state:v5#/properties/source"
    },
    "game": {
      "$ref": "urn:mtgaplayer:decision-state:v5#/properties/game"
    },
    "visible_objects": {
      "$ref": "urn:mtgaplayer:decision-state:v5#/properties/visible_objects"
    },
    "card_knowledge": {
      "$ref": "urn:mtgaplayer:decision-state:v5#/properties/card_knowledge"
    },
    "effect_claims": {
      "$ref": "urn:mtgaplayer:decision-state:v5#/properties/effect_claims"
    },
    "legal_action_space": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_type",
        "immediate_frontier",
        "choice_graph",
        "expanded_plans",
        "request_parameters"
      ],
      "properties": {
        "request_type": {
          "$ref": "urn:mtgaplayer:decision-state:v5#/properties/legal_action_space/properties/request_type"
        },
        "immediate_frontier": {
          "$ref": "urn:mtgaplayer:decision-state:v5#/properties/legal_action_space/properties/immediate_frontier"
        },
        "choice_graph": {
          "$ref": "urn:mtgaplayer:decision-state:v5#/properties/legal_action_space/properties/choice_graph"
        },
        "expanded_plans": {
          "$ref": "urn:mtgaplayer:decision-state:v5#/properties/legal_action_space/properties/expanded_plans"
        },
        "request_parameters": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "urn:mtgaplayer:decision-state:v5#/$defs/requestParameters"
            },
            {
              "$ref": "#/$defs/effectCostParameters"
            },
            {
              "$ref": "#/$defs/currentTargetParameters"
            }
          ]
        }
      },
      "allOf": [
        {
          "$ref": "urn:mtgaplayer:decision-state:v5#/properties/legal_action_space/allOf/0"
        },
        {
          "$ref": "urn:mtgaplayer:decision-state:v5#/properties/legal_action_space/allOf/1"
        },
        {
          "$ref": "urn:mtgaplayer:decision-state:v5#/properties/legal_action_space/allOf/2"
        },
        {
          "$ref": "urn:mtgaplayer:decision-state:v5#/properties/legal_action_space/allOf/3"
        },
        {
          "$ref": "urn:mtgaplayer:decision-state:v5#/properties/legal_action_space/allOf/4"
        },
        {
          "if": {
            "properties": {
              "request_parameters": {
                "type": "object",
                "properties": {
                  "profile": {
                    "const": "observed_nonmana_payment_select_single"
                  }
                },
                "required": [
                  "profile"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "request_type": {
                "const": "GREMessageType_PayCostsReq"
              },
              "choice_graph": {
                "type": "null"
              },
              "immediate_frontier": {
                "properties": {
                  "kind": {
                    "type": "null"
                  },
                  "availability": {
                    "const": "not_applicable"
                  },
                  "completeness": {
                    "const": "unknown"
                  },
                  "projection": {
                    "type": "null"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "unresolved": {
      "$ref": "urn:mtgaplayer:decision-state:v5#/properties/unresolved"
    },
    "execution": {
      "$ref": "urn:mtgaplayer:decision-state:v5#/properties/execution"
    },
    "read_only": {
      "$ref": "urn:mtgaplayer:decision-state:v5#/properties/read_only"
    }
  },
  "allOf": [
    {
      "$ref": "urn:mtgaplayer:decision-state:v5#/allOf/0"
    },
    {
      "$ref": "urn:mtgaplayer:decision-state:v5#/allOf/1"
    },
    {
      "$ref": "urn:mtgaplayer:decision-state:v5#/allOf/2"
    },
    {
      "$ref": "urn:mtgaplayer:decision-state:v5#/allOf/3"
    }
  ],
  "$defs": {
    "effectCostParameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "profile",
        "binding",
        "cost_selection",
        "historical_response_used"
      ],
      "properties": {
        "schema_version": {
          "const": "mtgaplayer.request-parameters.v3"
        },
        "profile": {
          "const": "observed_nonmana_payment_select_single"
        },
        "binding": {
          "allOf": [
            {
              "$ref": "urn:mtgaplayer:decision-state:v5#/$defs/binding"
            },
            {
              "properties": {
                "request_type": {
                  "const": "GREMessageType_PayCostsReq"
                },
                "request_id": {
                  "$ref": "urn:mtgaplayer:decision-state:v5#/$defs/id"
                }
              }
            }
          ]
        },
        "cost_selection": {
          "$ref": "#/$defs/effectCostSelection"
        },
        "historical_response_used": {
          "const": false
        }
      }
    },
    "effectCostSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "offered_object_refs",
        "weights",
        "min_sel",
        "max_sel",
        "min_weight",
        "max_weight",
        "allow_undo",
        "source_object_ref",
        "effect_cost_type",
        "context",
        "option_context",
        "list_type",
        "id_type",
        "validation_type",
        "allow_cancel"
      ],
      "properties": {
        "profile": {
          "const": "observed_nonmana_payment_select_single"
        },
        "offered_object_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "weights": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "const": 1
          }
        },
        "min_sel": {
          "const": 1
        },
        "max_sel": {
          "const": 1
        },
        "min_weight": {
          "const": -2147483648
        },
        "max_weight": {
          "const": 2147483647
        },
        "allow_undo": {
          "const": true
        },
        "source_object_ref": {
          "type": "null"
        },
        "effect_cost_type": {
          "const": "EffectCostType_Select"
        },
        "context": {
          "const": "SelectionContext_NonMana_Payment"
        },
        "option_context": {
          "const": "OptionContext_Payment"
        },
        "list_type": {
          "const": "SelectionListType_Dynamic"
        },
        "id_type": {
          "const": "IdType_InstanceId"
        },
        "validation_type": {
          "const": "SelectionValidationType_NonRepeatable"
        },
        "allow_cancel": {
          "const": "AllowCancel_Abort"
        }
      }
    },
    "currentTargetMenu": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "list_position",
        "action_type",
        "source_visible_object_ref",
        "target_idx",
        "offered_visible_target_refs",
        "offered_visible_target_count",
        "scope",
        "selection_count",
        "parameter_mode",
        "offered_targets_form_complete_legal_domain",
        "target_selection_legality_verified"
      ],
      "properties": {
        "list_position": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "action_type": {
          "const": "ActionType_Activate"
        },
        "source_visible_object_ref": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "target_idx": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "offered_visible_target_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "offered_visible_target_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "scope": {
          "const": "reviewed_public_battlefield_ids_only"
        },
        "selection_count": {
          "type": "null"
        },
        "parameter_mode": {
          "const": "future_choice_unverified"
        },
        "offered_targets_form_complete_legal_domain": {
          "const": false
        },
        "target_selection_legality_verified": {
          "const": false
        }
      }
    },
    "currentTargetRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "list_position",
        "action_type",
        "identifier_refs",
        "flags",
        "parameter_shapes",
        "other_fields_present",
        "target_menu",
        "ability_binding"
      ],
      "properties": {
        "list_position": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "action_type": {
          "$ref": "urn:mtgaplayer:decision-state:v5#/$defs/literalManaAction/properties/action_type"
        },
        "identifier_refs": {
          "$ref": "urn:mtgaplayer:decision-state:v5#/$defs/literalManaAction/properties/identifier_refs"
        },
        "flags": {
          "$ref": "urn:mtgaplayer:decision-state:v5#/$defs/literalManaAction/properties/flags"
        },
        "parameter_shapes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "manaCost": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "element_count"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "array",
                    "unexpected"
                  ]
                },
                "element_count": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 1000000
                }
              }
            },
            "targets": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "element_count"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "array",
                    "unexpected"
                  ]
                },
                "element_count": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 1000000
                }
              }
            },
            "manaPaymentOptions": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "element_count"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "array",
                    "unexpected"
                  ]
                },
                "element_count": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 1000000
                }
              }
            },
            "manaSelections": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "element_count"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "array",
                    "unexpected"
                  ]
                },
                "element_count": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 1000000
                }
              }
            },
            "autoTapSolution": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "auto_tap_actions_count"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "object",
                    "unexpected"
                  ]
                },
                "auto_tap_actions_count": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 1000000
                }
              }
            }
          }
        },
        "other_fields_present": {
          "type": "boolean"
        },
        "ability_binding": {
          "enum": [
            null,
            "verified_observed_pair",
            "observed_group_contradiction",
            "insufficient_evidence"
          ]
        },
        "target_menu": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/currentTargetMenu"
            }
          ]
        }
      }
    },
    "currentTargetParameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "profile",
        "binding",
        "rows",
        "public_battlefield_refs",
        "historical_response_used"
      ],
      "properties": {
        "schema_version": {
          "const": "mtgaplayer.request-parameters.v4"
        },
        "profile": {
          "const": "current_public_activate_target_member"
        },
        "binding": {
          "allOf": [
            {
              "$ref": "urn:mtgaplayer:decision-state:v5#/$defs/binding"
            },
            {
              "properties": {
                "request_type": {
                  "const": "GREMessageType_ActionsAvailableReq"
                },
                "request_id": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                }
              }
            }
          ]
        },
        "rows": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/currentTargetRow"
          }
        },
        "public_battlefield_refs": {
          "type": "array",
          "maxItems": 512,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "historical_response_used": {
          "const": false
        }
      }
    }
  }
}
